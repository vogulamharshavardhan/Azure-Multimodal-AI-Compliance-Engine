# Application
APP_ENV=development
API_KEY=replace-with-a-random-32-byte-or-longer-secret
HOST=127.0.0.1
PORT=8000
RELOAD=true
LOG_LEVEL=INFO
LOG_DIR=logs
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000
AUDIT_RATE_LIMIT_PER_MINUTE=5
MAX_CONCURRENT_AUDITS=2
MAX_QUEUED_AUDITS=100
REDIS_PASSWORD=replace-with-a-strong-random-redis-password
REDIS_URL=redis://:replace-with-a-strong-redis-password@localhost:6379/0

# Video ingestion safety limits
MAX_VIDEO_SIZE_MB=250
MAX_VIDEO_DURATION_SECONDS=1200
MAX_VIDEO_DIMENSION=1920
VIDEO_INDEXER_TIMEOUT_SECONDS=1800
VIDEO_TRANSCODE_TIMEOUT_SECONDS=1800
VIDEO_TRANSCODE_PRESET=veryfast

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=compilancestorage
AZURE_STORAGE_SAS_TTL_MINUTES=60

# Azure AI Foundry (Grok)
AZURE_AI_FOUNDRY_ENDPOINT=
AZURE_AI_FOUNDRY_API_KEY=
GROK_DEPLOYMENT_NAME=

# Azure OpenAI embeddings
AZURE_OPENAI_EMBEDDING_ENDPOINT=
AZURE_OPENAI_EMBEDDING_API_KEY=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_API_VERSION=

# Azure AI Search
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX_NAME=
MIN_POLICY_RELEVANCE_SCORE=0.15

# Azure Video Indexer
AZURE_VI_NAME=
# Optional local service-principal auth for DefaultAzureCredential. In Azure, prefer managed identity.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_VI_LOCATION=
AZURE_VI_ACCOUNT_ID=
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=

# Observability (optional but recommended)
APPLICATIONINSIGHTS_CONNECTION_STRING=
APPLICATIONINSIGHTS_STATSBEAT_DISABLED=true
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=brand-guardian-prod

# Optional: cache extracted transcript/OCR in Redis (0 disables). URL-based cache may be stale after video edits.
EXTRACTION_CACHE_TTL_SECONDS=0
# Increase to 2 after validating model rate limits; maximum 4.
OCR_BATCH_CONCURRENCY=1
